{
  "name": "belljar",
  "description": "A tool for mouse neurohistology",
  "version": "11.0.0",
  "main": "main.js",
  "repository": "asoronow/belljar",
  "author": "Alec <a.soronow@gmail.com>",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile": "tsc",
    "test": "tsc && node --test __tests__/",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make:osx64": "electron-forge make --platform=darwin --arch=x64",
    "make:win32": "electron-forge make --platform=win32 --arch=x64",
    "make:linuxarm64": "electron-forge make --platform=linux --arch=arm64",
    "make:linuxamd64": "electron-forge make --platform=linux --arch=x64",
    "make:all": "yarn make:osx64 && yarn make:win32 && yarn make:linuxarm64 && yarn make:linuxamd64"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.1.1",
    "python-shell": "^3.0.1",
    "semver": "^7.5.4",
    "tar": "^7.5.23"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^4.29.0",
    "@typescript-eslint/parser": "^4.29.0",
    "dotenv": "^16.3.1",
    "electron": "45.3.0",
    "eslint": "^7.32.0",
    "prettier": "^2.7.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@electron/asar@^4": {
      "glob": "^14.0.5",
      "minimatch": "^11.0.8"
    }
  },
  "build": {
    "appId": "com.belljar.app",
    "productName": "Bell Jar"
  }
}
